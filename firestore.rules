rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'einsgateindonesia@gmail.com'
      );
    }

    // Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'theme', 'displayMode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'theme', 'displayMode', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['operator', 'admin']
        && data.theme in ['dark', 'light']
        && data.displayMode in ['grid', 'stream']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookmarkDispatch(data, userId, bookmarkId) {
      return data.keys().hasAll(['uid', 'hashId', 'title', 'summary', 'link', 'sourceId', 'sourceName', 'category', 'language', 'publishedAt', 'savedAt'])
        && data.keys().hasOnly(['uid', 'hashId', 'title', 'summary', 'link', 'sourceId', 'sourceName', 'category', 'language', 'publishedAt', 'savedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.hashId is string && data.hashId == bookmarkId && isValidId(data.hashId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 500
        && data.summary is string && data.summary.size() <= 1000
        && data.link is string && data.link.size() >= 1 && data.link.size() <= 1000 && data.link.matches('^https?://.+')
        && data.sourceId is string && data.sourceId.size() >= 1 && data.sourceId.size() <= 128
        && data.sourceName is string && data.sourceName.size() >= 1 && data.sourceName.size() <= 150
        && data.category in ['indonesia', 'world', 'technology', 'economy', 'science', 'defense', 'cyber']
        && data.language in ['id', 'en']
        && data.publishedAt is string && data.publishedAt.size() >= 1 && data.publishedAt.size() <= 64
        && data.savedAt is timestamp;
    }

    function isValidCustomRssSource(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'url', 'category', 'language', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'url', 'category', 'language', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 1000 && data.url.matches('^https?://.+')
        && data.category in ['indonesia', 'world', 'technology', 'economy', 'science', 'defense', 'cyber']
        && data.language in ['id', 'en']
        && data.description is string && data.description.size() <= 300
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Admin collection (read-only for self, never client-writable)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, write: if false;
    }

    // Operator User Profiles & Preferences
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (incoming().role == 'operator' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'theme', 'displayMode', 'updatedAt']))
          || isAdmin()
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Bookmarked Intelligence Dispatches
      match /bookmarks/{bookmarkId} {
        allow get: if isValidId(userId) && isValidId(bookmarkId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(bookmarkId)
          && isOwner(userId)
          && isValidBookmarkDispatch(incoming(), userId, bookmarkId)
          && incoming().savedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(bookmarkId) && (isOwner(userId) || isAdmin());
      }

      // Custom Operator RSS Nodes
      match /customSources/{sourceId} {
        allow get: if isValidId(userId) && isValidId(sourceId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(sourceId)
          && isOwner(userId)
          && isValidCustomRssSource(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(sourceId)
          && isValidCustomRssSource(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'url', 'category', 'language', 'description', 'active', 'updatedAt']))
            || isAdmin()
          );

        allow delete: if isValidId(userId) && isValidId(sourceId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
