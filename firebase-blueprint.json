{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Operator profile and terminal display preferences for VEDA News Dashboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the operator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Operator callsign or display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["operator", "admin"],
          "description": "Assigned terminal access role."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "Preferred terminal visual theme."
        },
        "displayMode": {
          "type": "string",
          "enum": ["grid", "stream"],
          "description": "Preferred dispatch layout mode."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "role", "theme", "displayMode", "createdAt", "updatedAt"]
    },
    "BookmarkDispatch": {
      "title": "BookmarkDispatch",
      "description": "Intelligence dispatch bookmarked by an authenticated operator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hashId": {
          "type": "string",
          "description": "SHA-256 deduplication hash of the article.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Dispatch headline.",
          "minLength": 1,
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "description": "Sanitized dispatch summary.",
          "minLength": 0,
          "maxLength": 1000
        },
        "link": {
          "type": "string",
          "description": "Canonical external URL of the article.",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^https?://.+"
        },
        "sourceId": {
          "type": "string",
          "description": "Source identifier.",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceName": {
          "type": "string",
          "description": "Human-readable publisher name.",
          "minLength": 1,
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "enum": ["indonesia", "world", "technology", "economy", "science", "defense", "cyber"],
          "description": "Intelligence sector category."
        },
        "language": {
          "type": "string",
          "enum": ["id", "en"],
          "description": "Language code of the dispatch."
        },
        "publishedAt": {
          "type": "string",
          "description": "ISO-8601 publication timestamp.",
          "minLength": 1,
          "maxLength": 64
        },
        "savedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when dispatch was bookmarked."
        }
      },
      "required": ["uid", "hashId", "title", "summary", "link", "sourceId", "sourceName", "category", "language", "publishedAt", "savedAt"]
    },
    "CustomRssSource": {
      "title": "CustomRssSource",
      "description": "User-registered custom RSS feed node persisted in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Feed node name.",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "description": "RSS/Atom feed URL.",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^https?://.+"
        },
        "category": {
          "type": "string",
          "enum": ["indonesia", "world", "technology", "economy", "science", "defense", "cyber"],
          "description": "Intelligence sector category."
        },
        "language": {
          "type": "string",
          "enum": ["id", "en"],
          "description": "Language code."
        },
        "description": {
          "type": "string",
          "description": "Optional operational remarks.",
          "minLength": 0,
          "maxLength": 300
        },
        "active": {
          "type": "boolean",
          "description": "Whether this custom node is active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": ["uid", "name", "url", "category", "language", "description", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores operator profile metadata and synchronized VEDA terminal preferences."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/BookmarkDispatch" },
      "description": "Stores news dispatches bookmarked by the operator."
    },
    "/users/{userId}/customSources/{sourceId}": {
      "schema": { "$ref": "#/entities/CustomRssSource" },
      "description": "Stores custom RSS feed sources added by the operator."
    }
  }
}
